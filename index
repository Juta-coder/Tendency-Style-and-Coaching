<title>เข็มทิศสไตล์โค้ช</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Taviraj:wght@300;400;500;600&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap">
<style>
  :root{
    --bg:#EDF2FA;
    --surface:#FFFFFF;
    --surface-alt:#E3EAF7;
    --ink:#0E1C3F;
    --ink-muted:#57648A;
    --line:#D4DEF0;
    --brand:#0033CC;
    --brand-dark:#002060;
    --cyan:#04ADF0;
    --brand-ink:#FFFFFF;
    --brand-soft:#E0E8FC;
    --cyan-soft:#DEF4FE;
    --passive:#3A5FA0;
    --assertive:#0EA5A0;
    --aggressive:#C0392B;
    --passive-soft:#E4EAF5;
    --assertive-soft:#DEF3F1;
    --aggressive-soft:#F6E1DD;
    --shadow: 0 1px 2px rgba(0,32,96,.06), 0 10px 28px -14px rgba(0,32,96,.22);
    --radius-lg: 20px;
    --radius-md: 12px;
    --radius-sm: 8px;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#0A1226;
      --surface:#121C38;
      --surface-alt:#17223F;
      --ink:#E9EFFC;
      --ink-muted:#93A2C4;
      --line:#283153;
      --brand:#5B86FF;
      --brand-dark:#9FC1FF;
      --cyan:#3FC6F5;
      --brand-ink:#0A1226;
      --brand-soft:#182A55;
      --cyan-soft:#123244;
      --passive:#5A7AD8;
      --assertive:#0EA294;
      --aggressive:#DC5A46;
      --passive-soft:#1C2740;
      --assertive-soft:#122E2B;
      --aggressive-soft:#3A241F;
      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 12px 28px -14px rgba(0,0,0,.55);
    }
  }
  :root[data-theme="dark"]{
    --bg:#0A1226;
    --surface:#121C38;
    --surface-alt:#17223F;
    --ink:#E9EFFC;
    --ink-muted:#93A2C4;
    --line:#283153;
    --brand:#5B86FF;
    --brand-dark:#9FC1FF;
    --cyan:#3FC6F5;
    --brand-ink:#0A1226;
    --brand-soft:#182A55;
    --cyan-soft:#123244;
    --passive:#5A7AD8;
    --assertive:#0EA294;
    --aggressive:#DC5A46;
    --passive-soft:#1C2740;
    --assertive-soft:#122E2B;
    --aggressive-soft:#3A241F;
    --shadow: 0 1px 2px rgba(0,0,0,.3), 0 12px 28px -14px rgba(0,0,0,.55);
  }

  *{ box-sizing:border-box; }
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:'IBM Plex Sans Thai','IBM Plex Sans', system-ui, sans-serif;
    padding-inline:20px;
    padding-block:36px 64px;
  }
  .wrap{ max-width:760px; margin-inline:auto; }
  h1,h2,h3{ font-family:'Taviraj','IBM Plex Sans Thai',serif; text-wrap:balance; margin:0; }
  .mono{ font-family:'IBM Plex Mono',monospace; font-variant-numeric:tabular-nums; }
  a{ color:inherit; }

  /* ---- top bar ---- */
  .topbar-outer{
    background:var(--surface); border-bottom:1px solid var(--line);
    margin:-36px -20px 32px; padding:16px 20px;
  }
  .topbar{
    max-width:760px; margin-inline:auto;
    display:flex; align-items:center; justify-content:space-between;
    gap:12px;
  }
  .brand{ display:flex; align-items:center; gap:12px; }
  .brand img{ height:34px; width:auto; display:block; }
  .brand .product{
    font-size:12.5px; letter-spacing:.05em;
    color:var(--ink-muted); font-weight:500;
    border-left:1px solid var(--line); padding-left:12px; line-height:1.35;
  }
  .step-label{
    font-size:12.5px; font-weight:600; color:var(--brand);
    background:var(--brand-soft); border-radius:999px; padding:6px 14px;
  }
  .step-label:empty{ display:none; }
  .topbar-right{ display:flex; align-items:center; gap:10px; }
  .lang-toggle{
    appearance:none; cursor:pointer; font-family:inherit;
    font-size:12px; font-weight:700; letter-spacing:.03em;
    border:1px solid var(--line); background:var(--surface-alt); color:var(--ink-muted);
    border-radius:999px; padding:6px 4px; display:inline-flex; gap:2px;
  }
  .lang-toggle span{ padding:3px 9px; border-radius:999px; }
  .lang-toggle span.active{ background:var(--brand); color:var(--brand-ink); }

  /* ---- cards ---- */
  .card{
    background:var(--surface);
    border:1px solid var(--line);
    border-radius:var(--radius-lg);
    box-shadow:var(--shadow);
    padding:32px;
  }
  @media (max-width:560px){ .card{ padding:22px; } }

  /* ---- intro ---- */
  .intro{ position:relative; overflow:hidden; }
  .intro .hexwatermark{ position:absolute; top:-40px; right:-60px; width:260px; height:260px; pointer-events:none; }
  .eyebrow{
    position:relative;
    display:inline-flex; align-items:center; gap:8px;
    font-size:12.5px; letter-spacing:.08em; text-transform:uppercase;
    color:var(--brand); font-weight:600; margin-bottom:14px;
  }
  .eyebrow::before{ content:""; width:16px; height:2px; background:var(--cyan); display:block; }
  .intro h1{ position:relative; font-size:clamp(28px,4.5vw,38px); font-weight:600; line-height:1.25; margin-bottom:14px; color:var(--brand-dark); }
  .intro p.lede{ position:relative; font-size:16.5px; line-height:1.7; color:var(--ink-muted); max-width:56ch; margin-bottom:22px; }
  .benefits-title{ font-size:12.5px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-muted); font-weight:600; margin-bottom:12px; }
  .benefits{ display:flex; flex-direction:column; gap:11px; margin-bottom:22px; }
  .benefit-item{ display:flex; gap:11px; align-items:flex-start; font-size:15px; line-height:1.6; }
  .benefit-item .check{
    flex:none; width:21px; height:21px; margin-top:1px; border-radius:50%;
    background:var(--brand-soft); color:var(--brand);
    display:flex; align-items:center; justify-content:center;
    font-size:12px; font-weight:700;
  }
  .meta-row{ display:flex; gap:18px; flex-wrap:wrap; margin-bottom:26px; padding-top:18px; border-top:1px solid var(--line); }
  .meta-item{ display:flex; align-items:center; gap:8px; font-size:13px; color:var(--ink-muted); }
  .meta-item .dot{ width:6px; height:6px; border-radius:50%; background:var(--brand); }
  .accordion{ display:flex; flex-direction:column; gap:10px; margin-bottom:24px; }
  .acc-item{ border:1px solid var(--line); border-radius:var(--radius-md); background:var(--surface-alt); overflow:hidden; }
  .acc-head{
    appearance:none; border:none; width:100%; cursor:pointer; font-family:inherit;
    background:transparent; text-align:left; padding:14px 16px;
    display:flex; align-items:center; gap:13px;
  }
  .acc-badge{
    flex:none; width:32px; height:32px; border-radius:9px;
    background:var(--brand); color:var(--brand-ink);
    font-family:'Taviraj',serif; font-weight:600; font-size:16px;
    display:flex; align-items:center; justify-content:center;
  }
  .acc-titles{ flex:1; min-width:0; }
  .acc-title{ display:block; font-size:14.5px; font-weight:600; color:var(--ink); }
  .acc-sub{ display:block; font-size:12.5px; color:var(--ink-muted); margin-top:2px; }
  .acc-chevron{ flex:none; color:var(--ink-muted); font-size:13px; transition:transform .15s ease; }
  .acc-item.open .acc-chevron{ transform:rotate(180deg); }
  .acc-body{ padding:0 16px 18px 61px; font-size:13.5px; line-height:1.7; color:var(--ink); }
  .acc-examples{ margin-top:12px; }
  .acc-examples-title{ font-size:11.5px; text-transform:uppercase; letter-spacing:.05em; color:var(--ink-muted); font-weight:600; margin-bottom:6px; }
  .acc-body ul{ margin:0; padding-left:18px; }
  .acc-body li{ margin-bottom:6px; }
  .acc-reflect{
    margin-top:14px; padding:12px 14px; border-radius:var(--radius-sm);
    background:var(--brand-soft);
  }
  .acc-reflect-label{ font-size:11.5px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:var(--brand-dark); margin-bottom:4px; }
  .acc-reflect-q{ font-style:italic; color:var(--ink); }
  .ladder{ display:flex; flex-direction:column; gap:13px; margin:14px 0; }
  .ladder-item{ display:flex; gap:12px; align-items:flex-start; }
  .ladder-dot{ flex:none; width:12px; height:12px; border-radius:50%; margin-top:5px; }
  .ladder-desc{ font-size:12.5px; color:var(--ink-muted); margin-top:2px; }
  .acc-lead{ font-size:13px; color:var(--ink-muted); margin:-8px 0 14px; }
  .id-fields{ display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:8px; }
  @media (max-width:560px){ .id-fields{ grid-template-columns:1fr; } }
  .field label{ display:block; font-size:12.5px; font-weight:600; color:var(--ink-muted); margin-bottom:6px; }
  .field input{
    width:100%; font-family:inherit; font-size:14.5px; color:var(--ink);
    background:var(--surface); border:1.5px solid var(--line); border-radius:var(--radius-sm);
    padding:11px 13px;
  }
  .field input:focus{ outline:none; border-color:var(--brand); }
  .field input.invalid{ border-color:var(--aggressive); }
  .id-note{ font-size:12px; color:var(--ink-muted); margin-bottom:22px; }
  .btn{
    appearance:none; border:none; cursor:pointer;
    font-family:inherit; font-size:15.5px; font-weight:600;
    border-radius:999px; padding:14px 26px;
    display:inline-flex; align-items:center; gap:8px;
    transition:transform .12s ease, opacity .12s ease;
  }
  .btn:active{ transform:scale(.98); }
  .btn:focus-visible{ outline:2px solid var(--brand); outline-offset:2px; }
  .btn-primary{ background:var(--brand); color:var(--brand-ink); }
  .btn-primary:hover{ background:var(--brand-dark); }
  .btn-ghost{ background:transparent; color:var(--ink-muted); border:1px solid var(--line); }
  .btn-ghost:hover{ color:var(--ink); border-color:var(--ink-muted); }
  .note{ font-size:13px; color:var(--ink-muted); margin-top:14px; }

  /* ---- quiz ---- */
  .ticks{ display:flex; gap:4px; margin-bottom:22px; flex-wrap:wrap; }
  .tick{ height:6px; flex:1; min-width:8px; border-radius:3px; background:var(--surface-alt); border:1px solid var(--line); }
  .tick.done{ background:var(--brand); border-color:var(--brand); }
  .tick.current{ background:var(--cyan); border-color:var(--cyan); }
  .quiz-meta{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:18px; }
  .quiz-count{ font-size:13px; color:var(--ink-muted); }
  .stage-tag{
    display:inline-flex; align-items:center; gap:6px;
    font-size:12px; font-weight:600; letter-spacing:.04em; text-transform:uppercase;
    color:var(--brand); background:var(--brand-soft); border-radius:999px;
    padding:5px 12px; margin-bottom:16px;
  }
  .q-text{ font-size:clamp(19px,3vw,23px); line-height:1.55; font-weight:500; margin-bottom:26px; color:var(--brand-dark); }
  .options{ display:flex; flex-direction:column; gap:10px; }
  .option{
    text-align:left; width:100%;
    background:var(--surface-alt); border:1.5px solid var(--line);
    border-radius:var(--radius-md); padding:16px 18px;
    font-size:15px; line-height:1.55; color:var(--ink);
    cursor:pointer; transition:border-color .12s ease, background .12s ease;
  }
  .option:hover{ border-color:var(--brand); }
  .option.selected{ border-color:var(--brand); background:var(--brand-soft); }
  .quiz-nav{ display:flex; justify-content:space-between; align-items:center; margin-top:24px; }

  /* ---- results ---- */
  .archetype-eyebrow{ font-size:12.5px; letter-spacing:.08em; text-transform:uppercase; color:var(--ink-muted); margin-bottom:8px; }
  .archetype-name{ font-size:clamp(26px,4vw,32px); font-weight:600; margin-bottom:6px; color:var(--brand-dark); }
  .archetype-sub{ font-size:15px; color:var(--ink-muted); margin-bottom:16px; }
  .archetype-desc{ font-size:15.5px; line-height:1.75; max-width:60ch; }

  .section-title{ font-size:13px; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-muted); font-weight:600; margin-bottom:14px; }

  .gauge-card{ margin-top:18px; }
  .gauge-value{ display:flex; align-items:baseline; gap:8px; margin-bottom:14px; }
  .gauge-value .num{ font-size:34px; font-weight:600; }
  .gauge-value .label{ font-size:14px; color:var(--ink-muted); }
  .gauge-legend{ display:flex; gap:18px; margin-top:12px; flex-wrap:wrap; }
  .legend-item{ display:flex; align-items:center; gap:7px; font-size:13px; color:var(--ink-muted); }
  .legend-swatch{ width:10px; height:10px; border-radius:3px; }

  .stage-grid{ display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:18px; }
  @media (max-width:600px){ .stage-grid{ grid-template-columns:1fr; } }
  .stage-card{ background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-md); padding:18px; }
  .stage-head{ display:flex; align-items:baseline; gap:8px; margin-bottom:10px; }
  .stage-head .letter{ font-family:'Taviraj',serif; font-size:18px; font-weight:600; color:var(--brand); }
  .stage-head .name{ font-size:13.5px; font-weight:600; }
  .stage-bar{ display:flex; gap:2px; height:10px; border-radius:5px; overflow:hidden; background:var(--surface-alt); margin-bottom:10px; }
  .stage-bar .seg{ height:100%; }
  .stage-counts{ display:flex; gap:10px; margin-bottom:10px; font-size:12px; color:var(--ink-muted); }
  .stage-counts b{ color:var(--ink); font-weight:600; }
  .stage-insight{ font-size:13.5px; line-height:1.6; color:var(--ink); }

  .list-cols{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:18px; }
  @media (max-width:600px){ .list-cols{ grid-template-columns:1fr; } }
  .list-col h3{ font-size:15px; font-weight:600; margin-bottom:12px; display:flex; align-items:center; gap:8px; }
  .list-col h3 .dot{ width:9px; height:9px; border-radius:50%; }
  .item-row{ border-radius:var(--radius-sm); background:var(--surface-alt); border:1px solid var(--line); padding:12px 14px; margin-bottom:10px; font-size:13.5px; line-height:1.6; }
  .item-row .tag{ display:block; font-size:11.5px; text-transform:uppercase; letter-spacing:.04em; color:var(--ink-muted); margin-bottom:4px; font-weight:600; }
  .item-row .tip{ display:block; margin-top:8px; padding-top:8px; border-top:1px dashed var(--line); color:var(--brand-dark); font-size:13px; }
  .normalize-note{ font-size:13px; line-height:1.6; color:var(--ink-muted); margin-bottom:16px; padding:12px 14px; background:var(--brand-soft); border-radius:var(--radius-sm); }

  .reflect{ margin-top:18px; }
  .reflect ol{ margin:0; padding-left:20px; font-size:14.5px; line-height:1.8; }
  .reflect li{ margin-bottom:6px; }

  .result-actions{ display:flex; gap:10px; margin-top:26px; flex-wrap:wrap; }

  .resource-link{
    display:flex; align-items:center; gap:14px;
    text-decoration:none; color:inherit;
    background:var(--brand-soft); border:1px solid var(--line);
    border-radius:var(--radius-md); padding:16px 18px; margin-top:24px;
    transition:border-color .12s ease;
  }
  .resource-link:hover{ border-color:var(--brand); }
  .resource-link .icon{
    flex:none; width:38px; height:38px; border-radius:10px;
    background:var(--surface); color:var(--brand);
    display:flex; align-items:center; justify-content:center; font-size:18px;
  }
  .resource-link .title{ font-size:14.5px; font-weight:600; color:var(--brand-dark); }
  .resource-link .desc{ font-size:12.5px; color:var(--ink-muted); margin-top:2px; }
  .resource-link .arrow{ margin-left:auto; flex:none; color:var(--brand); font-size:18px; }

  [hidden]{ display:none !important; }

  @media print{
    body{ background:#fff; color:#000; padding:0; }
    .topbar, .result-actions, .btn{ display:none !important; }
    .card{ box-shadow:none; border:1px solid #ccc; }
  }
</style>

<div class="topbar-outer">
  <div class="topbar">
    <div class="brand">
      <img src="data:image/png;base64," alt="Thai Wah — TLX Leadership eXcelerated Program">
      <span class="product" data-i18n-html="topbar.product">เข็มทิศ<br>สไตล์โค้ช</span>
    </div>
    <div class="topbar-right">
      <div class="step-label" id="stepLabel"></div>
      <button class="lang-toggle" id="langToggle" type="button" aria-label="Switch language">
        <span data-lang-opt="th">TH</span><span data-lang-opt="en">EN</span>
      </button>
    </div>
  </div>
</div>
<div class="wrap">

  <section id="screen-intro">
    <div class="card intro">
      <svg class="hexwatermark" viewBox="0 0 200 200" aria-hidden="true">
        <polygon points="100,6 175,50 175,150 100,194 25,150 25,50" fill="none" stroke="var(--brand)" stroke-width="3" opacity="0.08"></polygon>
        <polygon points="100,36 149,64 149,136 100,164 51,136 51,64" fill="none" stroke="var(--cyan)" stroke-width="3" opacity="0.12"></polygon>
      </svg>
      <div class="eyebrow" data-i18n="intro.eyebrow">TLX · Self Discovery</div>
      <h1 data-i18n="intro.h1">มารู้จักตัวเองในบทบาทโค้ช ในอีกมุมหนึ่ง</h1>
      <p class="lede" data-i18n-html="intro.lede">แบบสำรวจตัวเอง 20 สถานการณ์ ชวนคุณย้อนดูวิธีที่มักพูดและตอบสนองจริงเมื่ออยู่ในบทบาทโค้ช เพื่อให้เห็นตัวเองในมุมที่อาจไม่เคยสังเกตมาก่อน ไม่มีคำตอบถูกหรือผิด เลือกคำตอบที่ใกล้เคียงกับสิ่งที่คุณ<b>มักจะทำจริง</b> มากที่สุด</p>
      <div class="benefits-title" data-i18n="intro.benefitsTitle">ทำแล้วคุณจะได้</div>
      <div class="benefits" data-i18n-html="intro.benefits">
        <div class="benefit-item"><span class="check">✓</span><span>เห็นแนวโน้มการโค้ชของตัวเอง แยกตามแต่ละช่วงของบทสนทนา ไม่ใช่ภาพรวมกว้างๆ ที่รู้อยู่แล้ว</span></div>
        <div class="benefit-item"><span class="check">✓</span><span>รู้ว่าจุดแข็งไหนควรใช้ต่อ และจุดไหนที่อาจกลายเป็นนิสัยโดยไม่รู้ตัวเวลาคุมสถานการณ์ไม่ได้</span></div>
        <div class="benefit-item"><span class="check">✓</span><span>ได้คำถามชวนคิดต่อสำหรับฝึกตัวเองอย่างเจาะจง แทนคำแนะนำทั่วไปที่ใช้กับใครก็ได้</span></div>
      </div>
      <div class="meta-row" data-i18n-html="intro.meta">
        <div class="meta-item"><span class="dot"></span>20 สถานการณ์</div>
        <div class="meta-item"><span class="dot"></span>ใช้เวลาราว 5–7 นาที</div>
        <div class="meta-item"><span class="dot"></span>เห็นผลทันทีเมื่อทำเสร็จ</div>
      </div>
      <div class="section-title" data-i18n="intro.reviewTitle">ทบทวนก่อนเริ่ม</div>
      <p class="acc-lead" data-i18n="intro.reviewLead">กดที่การ์ดเพื่อเปิดอ่าน — แต่ละเรื่องปิดท้ายด้วยคำถามชวนคิด 1 ข้อ</p>
      <div class="accordion" id="knowledgeAccordion">
        <div class="acc-item">
          <button class="acc-head" type="button" data-target="acc-active-listening">
            <span class="acc-badge">A</span>
            <span class="acc-titles" data-i18n-html="card.listening.titles"><span class="acc-title">Active Listening</span><span class="acc-sub">โค้ชที่ดีพูดน้อยกว่าที่คิด แต่ฟังลึกกว่าที่เคย</span></span>
            <span class="acc-chevron">⌄</span>
          </button>
          <div class="acc-body" id="acc-active-listening" data-i18n-html="card.listening.body" hidden>
            <p>การฟังมีตั้งแต่ “ไม่ฟังเลย” ไปจนถึง “อยู่กับเขาเต็มร้อย” — ยิ่งไล่ลง ยิ่งเข้มขึ้น:</p>
            <div class="ladder">
              <div class="ladder-item"><span class="ladder-dot" style="background:color-mix(in oklab, var(--brand) 20%, var(--surface-alt))"></span><div><b>Ignoring</b> — ไม่ฟังเลย<div class="ladder-desc">ใจลอยไปเรื่องอื่น ทำงานอื่นไปด้วยขณะคุย</div></div></div>
              <div class="ladder-item"><span class="ladder-dot" style="background:color-mix(in oklab, var(--brand) 40%, var(--surface-alt))"></span><div><b>Pretending</b> — ทำท่าฟัง<div class="ladder-desc">พยักหน้าตอบรับ แต่ใจไม่ได้อยู่กับเรื่องที่คุย</div></div></div>
              <div class="ladder-item"><span class="ladder-dot" style="background:color-mix(in oklab, var(--brand) 62%, var(--surface-alt))"></span><div><b>Selective</b> — ฟังเฉพาะที่สนใจ<div class="ladder-desc">รับฟังแค่ส่วนที่ตรงกับตัวเอง หรือรอจังหวะจะพูดต่อ</div></div></div>
              <div class="ladder-item"><span class="ladder-dot" style="background:color-mix(in oklab, var(--brand) 84%, var(--surface-alt))"></span><div><b>Attentive</b> — ตั้งใจฟัง<div class="ladder-desc">ฟังเนื้อหาที่พูดอย่างเต็มที่ ไม่ตัดบท</div></div></div>
              <div class="ladder-item"><span class="ladder-dot" style="background:var(--brand-dark)"></span><div><b>Present</b> — อยู่กับเขาเต็มร้อย<div class="ladder-desc">ฟังทั้งคำพูด อารมณ์ น้ำเสียง และสิ่งที่ไม่ได้พูดออกมา</div></div></div>
            </div>
            <p>เทคนิคที่ช่วยขยับไปสู่ระดับ Present: สะท้อนกลับสิ่งที่ได้ยิน (“ฟังดูเหมือนคุณกังวลเรื่อง… ใช่ไหม”) เว้นจังหวะเงียบ 3–5 วินาทีก่อนพูดต่อ ถามแทนการสรุปเอง และสังเกตสิ่งที่ “ไม่ถูกพูดถึง” ให้เท่ากับสิ่งที่พูดออกมา</p>
            <div class="acc-reflect">
              <div class="acc-reflect-label">ชวนคิด</div>
              <div class="acc-reflect-q">วันนี้เวลาคุยกับทีม ส่วนใหญ่คุณอยู่ระดับไหนใน 5 ระดับนี้ — แล้วอะไรที่ดึงคุณลงจาก Present?</div>
            </div>
          </div>
        </div>
        <div class="acc-item">
          <button class="acc-head" type="button" data-target="acc-bias">
            <span class="acc-badge" style="background:var(--brand-dark)">B</span>
            <span class="acc-titles" data-i18n-html="card.bias.titles"><span class="acc-title">การจัดการอคติ (Managing Bias)</span><span class="acc-sub">ทุกคนมีอคติ — จุดเริ่มต้นของโค้ชที่ดีคือรู้ทันมัน</span></span>
            <span class="acc-chevron">⌄</span>
          </button>
          <div class="acc-body" id="acc-bias" data-i18n-html="card.bias.body" hidden>
            <p><b>อคติ (Bias)</b> คือทางลัดทางความคิดที่สมองใช้ตัดสินใจเร็วๆ โดยไม่รู้ตัว ซึ่งกระทบโดยตรงกับสิ่งที่โค้ชได้ยินและตัดสินระหว่างบทสนทนา</p>
            <div class="acc-examples"><div class="acc-examples-title">อคติที่พบบ่อยเวลาโค้ช</div><ul>
              <li><b>Halo / Horn Effect</b> — ตัดสินคนทั้งคนจากความประทับใจแรกหรือเรื่องเดียว</li>
              <li><b>Similarity Bias</b> — เข้าข้างหรือเชื่อคนที่คิด/ทำงานคล้ายเรามากกว่า</li>
              <li><b>Attribution Bias</b> — คิดว่าปัญหาเกิดจาก “ตัวคน” ทั้งที่จริงอาจมาจาก “สถานการณ์”</li>
              <li><b>Advice-Giving Bias</b> — รีบเอาประสบการณ์ตัวเองไปตัดสิน/แนะนำ ก่อนเข้าใจบริบทของเขา</li>
            </ul></div>
            <p>วิธีจัดการ: หยุดสังเกตตัวเอง ถามว่า “ฉันกำลังสรุปจากข้อมูลจริง หรือจากความรู้สึกแรก” แยก “สิ่งที่เห็น/ได้ยิน” ออกจาก “สิ่งที่ตีความ” ก่อนพูดออกไป และรอฟังให้ครบก่อนตัดสิน</p>
            <div class="acc-reflect">
              <div class="acc-reflect-label">ชวนคิด</div>
              <div class="acc-reflect-q">ครั้งล่าสุดที่คุณด่วนสรุปเกี่ยวกับใครสักคน คุณตัดสินจากข้อมูลจริง หรือจากความรู้สึกแรกกันแน่?</div>
            </div>
          </div>
        </div>
        <div class="acc-item">
          <button class="acc-head" type="button" data-target="acc-g">
            <span class="acc-badge">G</span>
            <span class="acc-titles" data-i18n-html="card.g.titles"><span class="acc-title">Goal — ตั้งเป้าหมาย</span><span class="acc-sub">จุดเริ่มต้นของบทสนทนา ชวนหาว่าวันนี้อยากได้อะไรกลับไป</span></span>
            <span class="acc-chevron">⌄</span>
          </button>
          <div class="acc-body" id="acc-g" data-i18n-html="card.g.body" hidden>
            <p>ก่อนจะแก้ปัญหาอะไร ต้องรู้ก่อนว่ากำลังจะไปที่ไหน โค้ชที่ดีช่วยให้ลูกทีมตั้งเป้าหมายของ “บทสนทนาวันนี้” ให้ชัดเจนและจับต้องได้ ไม่ใช่แค่เป้าหมายระยะยาวที่ยังคลุมเครือ</p>
            <div class="acc-examples"><div class="acc-examples-title">คำถามตัวอย่าง</div><ul>
              <li>วันนี้อยากคุยเรื่องอะไร</li>
              <li>ถ้าคุยจบแล้วได้อะไรกลับไป จะรู้สึกว่าคุ้มค่า</li>
              <li>เป้าหมายนี้สำคัญกับคุณยังไง</li>
            </ul></div>
            <div class="acc-reflect">
              <div class="acc-reflect-label">ชวนคิด</div>
              <div class="acc-reflect-q">เป้าหมายที่คุณตั้งให้ลูกทีมบ่อยๆ เป็นเป้าหมายของเขาจริงๆ หรือเป็นเป้าหมายที่คุณอยากให้เขามีกันแน่?</div>
            </div>
          </div>
        </div>
        <div class="acc-item">
          <button class="acc-head" type="button" data-target="acc-r">
            <span class="acc-badge">R</span>
            <span class="acc-titles" data-i18n-html="card.r.titles"><span class="acc-title">Reality — สำรวจความจริง</span><span class="acc-sub">สำรวจสถานการณ์ปัจจุบันตามจริง ก่อนกระโดดไปหาทางแก้</span></span>
            <span class="acc-chevron">⌄</span>
          </button>
          <div class="acc-body" id="acc-r" data-i18n-html="card.r.body" hidden>
            <p>ขั้นนี้คือการทำความเข้าใจสถานการณ์ที่แท้จริง ทั้งข้อเท็จจริง ความรู้สึก และสิ่งที่เคยลองทำมาแล้ว โดยไม่รีบตัดสินหรือด่วนสรุปแทนอีกฝ่าย</p>
            <div class="acc-examples"><div class="acc-examples-title">คำถามตัวอย่าง</div><ul>
              <li>ตอนนี้สถานการณ์เป็นยังไงบ้าง</li>
              <li>อะไรที่เคยลองทำไปแล้ว ได้ผลแค่ไหน</li>
              <li>ใครหรืออะไรที่เกี่ยวข้องกับเรื่องนี้บ้าง</li>
            </ul></div>
            <div class="acc-reflect">
              <div class="acc-reflect-label">ชวนคิด</div>
              <div class="acc-reflect-q">ครั้งล่าสุดที่ฟังปัญหาใครสักคน คุณรีบสรุปสถานการณ์ก่อนที่เขาจะเล่าจบหรือเปล่า?</div>
            </div>
          </div>
        </div>
        <div class="acc-item">
          <button class="acc-head" type="button" data-target="acc-o">
            <span class="acc-badge">O</span>
            <span class="acc-titles" data-i18n-html="card.o.titles"><span class="acc-title">Options — หาทางเลือก</span><span class="acc-sub">เปิดพื้นที่ให้คิดทางเลือกได้มากที่สุด ก่อนตัดสินใจ</span></span>
            <span class="acc-chevron">⌄</span>
          </button>
          <div class="acc-body" id="acc-o" data-i18n-html="card.o.body" hidden>
            <p>เป้าหมายของขั้นนี้คือปริมาณและความหลากหลายของทางเลือก ไม่ใช่คำตอบที่ “ถูกต้อง” ทางเดียว โค้ชที่ดีอดใจไม่เสนอคำตอบเอง แม้จะรู้สึกว่ามีคำตอบที่ดีอยู่ในใจแล้วก็ตาม</p>
            <div class="acc-examples"><div class="acc-examples-title">คำถามตัวอย่าง</div><ul>
              <li>มีทางเลือกอะไรบ้าง ลองคิดมาให้ได้มากที่สุด</li>
              <li>ถ้าไม่มีข้อจำกัดเลย จะทำอะไร</li>
              <li>แต่ละทางเลือกมีข้อดีข้อเสียยังไง</li>
            </ul></div>
            <div class="acc-reflect">
              <div class="acc-reflect-label">ชวนคิด</div>
              <div class="acc-reflect-q">เวลาลูกทีมตันทางความคิด คุณให้เวลาเขาคิดเองนานแค่ไหน ก่อนจะเสนอคำตอบให้?</div>
            </div>
          </div>
        </div>
        <div class="acc-item">
